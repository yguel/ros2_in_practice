msgid "Ajoutez à la fin du fichier les lignes suivantes:"
msgstr "Add the following lines at the end of the file:"

#: ../../source/c00_setup_de_ros2/c00s01_ros2_setup.rst:88
msgid "Addons au fichier .bashrc"
msgstr "Additions to the .bashrc file"

#: ../../source/c00_setup_de_ros2/c00s01_ros2_setup.rst:93
msgid "Enregistrez le fichier et fermez vscode."
msgstr "Save the file and close vscode."

#: ../../source/c00_setup_de_ros2/c00s01_ros2_setup.rst:95
msgid ""
"Rechargez votre fichier ``~/.bashrc`` pour prendre en compte les "
"modifications:"
msgstr "Reload your ``~/.bashrc`` file to apply the changes:"

#: ../../source/c00_setup_de_ros2/c00s01_ros2_setup.rst:101
msgid "Vous pouvez maintenant utiliser les macros bash que vous venez de définir."
msgstr "You can now use the bash macros you just defined."

#: ../../source/c00_setup_de_ros2/c00s01_ros2_setup.rst:103
msgid ""
